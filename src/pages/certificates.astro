---
// src/pages/certificates.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Сертификаты">
  <section style="padding: 2rem; background-color: #E6F0FF;">
    <h2 style="color: #007BFF;">Сертификаты</h2>
    <p style="color: #333;">Здесь представлены мои сертификаты и документы, подтверждающие квалификацию.</p>

  <div style="overflow-x: auto; white-space: nowrap; padding: 1rem 0;">
  <div class="certificate-gallery" style="display: inline-flex; gap: 1rem;">
    <img src="сертефикат1.jpg" alt="Сертификат 1" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
    <img src="сертефикат2.jpg" alt="Сертификат 2" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
    <img src="интернатура2.jpg" alt="Сертификат 3" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
    <img src="интернатура.jpg" alt="Сертификат 4" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
  </div>
</div>
  </section>
</MainLayout>