    <img src="выступление1.jpg" alt="Сертификат 1" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
    <img src="выступление2.jpg" alt="Сертификат 2" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
    <img src="выступление3.jpg" alt="Сертификат 3" style="height: 300px; border-radius: 10px; border: 2px solid #007BFF;" />
  </div>
</div>
